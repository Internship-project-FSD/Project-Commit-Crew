# Express API base URL. Example: http://localhost:5000
VITE_API_BASE_URL=http://localhost:5000

# Keep false when connecting to Member 2's backend.
# true enables local sample data and a client-side demo run; it does not run Playwright.
VITE_DEMO_MODE=false

# Dashboard authentication endpoints are NOT specified in D03. Confirm these with Member 2.
VITE_AUTH_LOGIN_PATH=/api/auth/login
VITE_AUTH_ME_PATH=/api/auth/me
VITE_AUTH_LOGOUT_PATH=/api/auth/logout

# The routes below are documented in D03_System_Design.
VITE_REPORTS_PATH=/api/reports
VITE_RUNS_PATH=/api/runs
VITE_FILES_PATH=/api/files
VITE_HEALTH_PATH=/api/health
